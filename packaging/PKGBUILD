pkgname=xspeedtest
pkgver=0.1.0
pkgrel=1
pkgdesc='Qt 6 / QML front-end for speedtest-cli with a Plasma 6 widget'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'kirigami' 'qqc2-desktop-style' 'kwindowsystem' 'libplasma' 'python' 'speedtest-cli')
makedepends=('cmake' 'extra-cmake-modules' 'ninja')
optdepends=('plasma-desktop: use the widget on the desktop or in a panel')

build() {
    cmake -S "$startdir/.." -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
